{% extends 'dashboard/index.html' %}
{% load bootstrap5 %}

{% block dashboard_header %}
    <h2 class="text-left mt-5">Prompts Management - delete prompt</h2>
{% endblock dashboard_header %}

{% block dashboard_content %}
    {% url 'dashboard:prompts' as prompts_list %}

    <p class="h5">Are you sure you want to delete the Prompt: {{ object.name }}?</p>
    <form action="" method="POST">
        {% csrf_token %}
        <div class="container d-flex ps-0">
            <input type="submit" class="btn btn-primary me-4 mt-4" value="Confirm">
