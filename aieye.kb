./templates/app/base.html
{% extends 'app/bootstrap.html' %}

{% load bootstrap5 %}

{% block bootstrap5_content %}
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container-fluid">
        <a href="{% url 'dashboard:index' %}" class="navbar-brand">AI-Eye Dashboard</a>
        <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
            <span class="navbar-toggler-icon"></span>
        </button>

        {% block header_navbar %}
        <div class="collapse navbar-collapse" id="navbarCollapse">
            <div class="navbar-nav">
                {% if user.is_authenticated %}
                    {% if user.is_aieye_admin %}
                        <a href="{% url 'dashboard:users' %}" class="nav-item nav-link {% if "dashboard/users" in request.path %}active{% endif %}">Users</a>
                        <a href="{% url 'dashboard:openaikeys' %}" class="nav-item nav-link {% if "dashboard/openaikeys" in request.path %}active{% endif %}">OpenAI Keys</a>
                        <a href="{% url 'dashboard:publictokens' %}" class="nav-item nav-link {% if "dashboard/publictokens" in request.path %}active{% endif %}">Public Tokens</a>
                        <a href="{% url 'dashboard:caches' %}" class="nav-item nav-link {% if "dashboard/caches" in request.path %}active{% endif %} ">Cache/Logs</a>
                    {% endif %}
                        <a href="{% url 'dashboard:prompts' %}" class="nav-item nav-link {% if "dashboard/prompts" in request.path %}active{% endif %} ">Prompts</a>
                        <a href="{% url 'dashboard:builtins' %}" class="nav-item nav-link {% if "dashboard/builtins" in request.path %}active{% endif %} ">Builtins</a>
                        <a href="{% url 'dashboard:pipelines' %}" class="nav-item nav-link {% if "dashboard/pipelines" in request.path %}active{% endif %} ">Pipelines</a>
                        <a href="{% url 'dashboard:pipelines_executions' %}" class="nav-item nav-link {% if "dashboard/pipeline/executions" in request.path %}active{% endif %} ">Pipelines Execution History</a>
                {% endif %}
            </div>
            <div class="navbar-nav ms-auto">
                {% if user.is_authenticated %}
                    <span class="navbar-text text-warning">Howdy {{ user.first_name|default:user.email }}!</span>
                    <a href="{% url 'access:logout' %}" class="nav-item nav-link">Logout</a>
                {% else %}
                    <a href="{% url 'access:login' %}" class="nav-item nav-link">Login</a>
                {% endif %}
            </div>
        </div>
        {% endblock header_navbar %}
    </div>
</nav>

<div class="container">
    {% autoescape off %}{% bootstrap_messages %}{% endautoescape %}

    {% block content %}{% endblock %}
<hr>

    {% block footer %}
    <footer>
        <div class="row">
            <div class="col-md-6">
                <p>Copyright &copy; <span id="copyright-year">{% now 'Y' %}</span> Hyperbach</p>
            </div>
            <div class="col-md-6 text-md-end">
                <a href="#" class="text-dark">Terms of Use</a>
                <span class="text-muted mx-2">|</span>
                <a href="#" class="text-dark">Privacy Policy</a>
            </div>
        </div>
    </footer>
    {% endblock footer %}
</div>
{% endblock %}

{% block bootstrap5_extra_script %}{% endblock %}
