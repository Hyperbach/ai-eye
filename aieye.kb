./templates/dashboard/builtins/list.html
{% extends 'dashboard/index.html' %}
{% load static %}
{% load bootstrap5 %}

{% block bootstrap5_extra_head %}
    {{ block.super }}
    <link rel="stylesheet" type="text/css" href="{% static 'css/custom.css' %}">
{% endblock %}

{% block dashboard_header %}
    <h2 class="text-left mt-5">Builtin Functions Management</h2>
{% endblock dashboard_header %}

{% block dashboard_content %}
    <div class="p-5 bg-light rounded-3">
        <div class="tab-pane fade show active ">
            <table class="table table-striped table-hover">
                <thead>
                <tr>
                    <th scope="col">Id</th>
                    <th scope="col">Name</th>
                    <th scope="col">Description</th>
                    <th scope="col">Function Type</th>
                    <th scope="col">Date created</th>
                    <th scope="col"></th>
                </tr>
                </thead>
                <tbody>
                {% if object_list %}
                    {% for builtin in object_list %}
                        <tr>
                            <td>{{ builtin.id }}</td>
                            <td>{{ builtin.name }}</td>
                            <td>{{ builtin.description }}</td>
                            <td>{{ builtin.get_fn_type }}</td>
                            <td>{{ builtin.date_created|date:'m-d-Y H:i:s' }}</td>
                            {% if user.is_aieye_admin %}
                                <td><a href="{% url 'dashboard:builtin_update' builtin.pk %}">Update</a></td>
                            {% else %}
                                <td></td>
                            {% endif %}
                        </tr>
                    {% endfor %}
                {% endif %}
                </tbody>
            </table>

            {% if user.is_aieye_admin %}
                <div class="d-flex ">
                    <a href="javascript:void(0);" class="d-block btn btn-primary my-2" id="sync_funcs">Sync functions</a>
                </div>
            {% endif %}

            <div class="d-flex justify-content-center align-items-center" id="spinner">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>

            <div class="mt-3 alert alert-success hidden" id="success-alert"></div>
            <div class="mt-3 alert alert-danger hidden" id="error-alert"></div>

        </div>
    </div>
{% endblock dashboard_content %}

{% block bootstrap5_extra_script %}
    <script type="text/javascript">
        $(function () {
            $('#spinner').addClass('hidden');

            $("#sync_funcs").click(function () {
                perform_ajax_call('/dashboard/builtins/sync',
                    'POST',
                    JSON.stringify({}),
                    function (response) {
                        $('#error-alert').addClass('hidden');

                        $('#success-alert').removeClass('hidden');
                        $('#success-alert').text(`Functions synced successfully! Added: ${response.created.length}, deleted: ${response.deleted.length}.`);

                        if (response.created.length) {
                            $('#success-alert').append('<br> Added functions: ' + response.created.join(', '));
                        }

                        if (response.deleted.length) {
                            $('#success-alert').append('<br> Deleted functions: ' + response.deleted.join(', '));
                        }

                        if (response.created.length || response.deleted.length) {
                            $('#success-alert').append('<br><a href="javascript:void()" onclick="location.reload()">Refresh page</a>');
                        }
                    },
                    function (error) {
                        $('#success-alert').addClass('hidden');

                        $('#error-alert').removeClass('hidden');
                        $('#error-alert').text('Error syncing functions. Please try again later.');
                    },
                    function () {
                        $('#spinner').removeClass('hidden');
                    },
                    function () {
                        $('#spinner').addClass('hidden');
                    },
                    '{{ csrf_token }}'
                )
            });
        });
    </script>
{% endblock %}
