{% extends 'dashboard/index.html' %}
{% load bootstrap5 %}

{% block dashboard_header %}
    <div class="header-container">
        <h2 class="text-left mt-5" style="display: inline-block; margin-right: 5px;">Cache/Logs Management</h2>
        <a href="{% url 'dashboard:caches_delete_all' %}" style="display: inline-block;">Delete all</a>
    </div>
{% endblock dashboard_header %}

{% block dashboard_content %}
    <div class="p-5 bg-light rounded-3">
        <div class="tab-pane fade show active ">
            <table class="table table-striped table-hover">
                <thead>
                <tr>
                    <th scope="col">Id</th>
                    <th scope="col">Endpoint</th>
                    <th scope="col">Parameters</th>
                    <th scope="col">User</th>
                    <th scope="col">API key</th>
                    <th scope="col">Response</th>
                    <th scope="col">Cache_hit</th>
                    <th scope="col">Timestamp</th>
                    <th scope="col"></th>
                </tr>
                </thead>
                <tbody>
                {% if object_list %}
                    {% for cache in object_list %}
                        <tr>
                            <td>{{ cache.id }}</td>
                            <td>{{ cache.endpoint }}</td>
                            <td>{{ cache.parameters }}</td>
                            <td>{{ cache.user }}</td>
                            <td>{{ cache.api_key|truncatechars:10 }}</td>
                            <td>{{ cache.response }}</td>
                            <td>{{ cache.cache_hit }}</td>
                            <td>{{ cache.timestamp|date:'m-d-Y H:i:s' }}</td>
                            <td><a href="{% url 'dashboard:caches_delete' cache.pk %}">Delete</a></td>
                        </tr>
                    {% endfor %}
                {% endif %}
                </tbody>
            </table>

            {#        <div class="d-flex ">#}
            {#            <a href="{% url 'dashboard:cache_create' %}" class="d-block btn btn-primary  my-2">Add New</a>#}
            {#        </div>#}
        </div>
    </div>

    {% if page_obj.has_other_pages %}
    <nav>
        <ul class="pagination justify-content-center mt-2">
            {% if page_obj.has_previous %}
                <li class="page-item">
                    <a class="page-link" href="?page=1">first</a>
                </li>
                <li class="page-item">
                    <a class="page-link" href="?page={{ page_obj.previous_page_number }}">previous</a>
                </li>
            {% endif %}

            {% for page_number in page_obj.paginator.page_range %}
                 {% if page_number <= page_obj.number|add:3 and page_number >= page_obj.number|add:-3 %}
                    {% if page_obj.number == page_number %}
                        <li class="page-item active">
                            <a class="page-link" href="?page={{ page_number }}">{{ page_number }}</a>
                        </li>
                    {% else %}
                        <li class="page-item">
                            <a class="page-link" href="?page={{ page_number }}">{{ page_number }}</a>
                        </li>
                    {% endif %}
                {% endif %}
            {% endfor %}

            {% if page_obj.has_next %}
                <li class="page-item">
                    <a class="page-link" href="?page={{ page_obj.next_page_number }}">next</a>
                </li>
                <li class="page-item">
                    <a class="page-link" href="?page={{ page_obj.paginator.num_pages }}">last</a>
                </li>
            {% endif %}
        </ul>
    </nav>
    {% endif %}
{% endblock dashboard_content %}
