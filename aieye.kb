./templates/dashboard/pipelines/execution_history.html
{% extends 'dashboard/index.html' %}
{% load static %}
{% load bootstrap5 %}

{% block bootstrap5_extra_head %}
    {{ block.super }}
    <link href="{% static 'css/fontawesomefree/fontawesome.css' %}" rel="stylesheet" type="text/css">
    <link href="{% static 'css/fontawesomefree/solid.css' %}" rel="stylesheet" type="text/css">
    <link href="{% static 'css/pipeline_exec_history.css' %}" rel="stylesheet" type="text/css">
{% endblock %}

{% block dashboard_header %}
<div class="header-container">
    <h2 class="text-left mt-5" style="display: inline-block; margin-right: 5px;">
        {% if pipeline %}
            {{ pipeline.name }} Execution History
        {% else %}
            Pipelines Execution History
        {% endif %}
    </h2>
</div>
{% endblock dashboard_header %}

{% block dashboard_content %}
    <div class="p-5 bg-light rounded-3">
        <div class="tab-pane fade show active ">
            <table class="table table-striped table-hover" id="execution-history">
                <thead>
                <tr>
                    <th scope="col">Id</th>
                    {% if not pipeline %}
                        <th scope="col">Pipeline Name</th>
                    {% endif %}
                    <th scope="col">Date started</th>
                    <th scope="col">Date ended</th>
                    <th scope="col">Status</th>
                </tr>
                </thead>
                <tbody>
                {% if page_obj %}
                    {% for execution in page_obj %}
                    <tr class="main-row" data-id="{{ execution.id }}">
                        <td>{{ execution.id }}</td>
                        {% if not pipeline %}
                            <td>
                                <a class="pipeline-detail-link" href="{% url 'dashboard:pipeline_detail_exec_history' execution.pipeline.id %}">
                                    {{ execution.pipeline.name }}
                                </a>
                            </td>
                        {% endif %}
                        <td>{{ execution.start_date|date:'m-d-Y H:i:s' }}</td>
                        <td>{{ execution.end_date|date:'m-d-Y H:i:s' }}</td>
                        <td>
                            <span class="{% if execution.status == 'success' %}text-success{% else %}text-danger{% endif %}">
                                {{ execution.get_status_display }}
                            </span>
                        </td>
                    </tr>
                    <tr class="extra-row" id="extra-{{ execution.id }}">
                        <td>
                            <b>Pipeline body</b>:
                            <div>{{ execution.pipeline.body }}</div>
                        </td>
                        <td>
                            <b>Parameters</b>:
                            <div>{{ execution.parameters }}</div>
                        </td>
                        <td>
                            <b>Output</b>:
                            <div>{{ execution.output }}</div>
                        </td>
                        <td>
                            {% if execution.error %}
                                <b>Error</b>:
                                <div>{{ execution.error }}</div>
                            {% endif %}
                        </td>
                        {% if not pipeline %}
                            <td></td>
                        {% endif %}
                    </tr>
                    {% endfor %}
                {% endif %}
                </tbody>
            </table>

            <nav aria-label="#">
              <ul class="pagination">
                {% if page_obj.has_previous %}
                <li class="page-item">
                  <a class="page-link" href="?page={{ page_obj.previous_page_number }}"
                     tabindex="-1" aria-disabled="true">
                      Previous
                  </a>
                </li>
                {% endif %}
                {% for num in page_range %}
                <li class="page-item {% if num == page_obj.number %}active{% endif %}" aria-current="page">
                  <a class="page-link" href="?page={{ num }}">{{ num }}</a>
                </li>
                {% endfor %}
                {% if page_obj.has_next %}
                    <li class="page-item">
                      <a class="page-link" href="?page={{ page_obj.next_page_number }}">Next</a>
                    </li>
                {% endif %}
              </ul>
            </nav>
        </div>
    </div>
{% endblock dashboard_content %}

{% block bootstrap5_extra_script %}
    <script>
        $(document).ready(function() {
            $('tr.main-row').on('click', function() {
                var id = $(this).data('id');
                var extra_row = $('#extra-' + id);
                $('tr.extra-row.show').not(extra_row).removeClass('show');
                extra_row.toggleClass('show');
            });

            $('a.pipeline-detail-link').on('click', function(e) {
                e.stopPropagation();
            });
        })
    </script>
{% endblock %}
